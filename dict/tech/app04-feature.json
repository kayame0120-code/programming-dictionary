          "default": "/",
          "reads": [
            "'home'\\s*=>\\s*'(?<v>[^']*)'",
            "'home'\\s*=>\\s*(?<v>[^'\\s,][^,\\n]*?)\\s*,"
          ],
          "via_note": {
            "t": "引用符で囲まない値（Laravel 8 の書き方）。URL は 《home》 の中身で決まる。RouteServiceProvider::HOME なら、app/Providers/RouteServiceProvider.php の HOME の行を見る"
          },
          "tr": "ログイン・会員登録が済んだら、URL 《home》 を開く"
        },
        {
          "key": "views",
          "label": "画面",
          "default": "true",
          "options": [
            {
              "v": "true",
              "label": "Bladeの画面を使う"
            },
            {
              "v": "false",
              "label": "画面を使わない（APIだけ）"
            }
          ],
          "reads": [
            "'views'\\s*=>\\s*(?<v>true|false)"
          ],
          "tr": "《views|label》"
        }
      ],
      "sections": [
        {
          "key": "features",
          "label": "できること"
        }
      ],
      "patches": [
        {
          "label": "ログイン後に開くURL",
          "find": "'home' => で始まる行",
