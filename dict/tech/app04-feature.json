          ],
          "field": "home",
          "start": "'home' =>",
          "until": "line"
        },
        {
          "label": "画面",
          "find": "'views' => で始まる行",
          "code": [
            "'views' => 《views》,"
          ],
          "field": "views",
          "start": "'views' =>",
          "until": "line"
        },
        {
          "label": "できること",
          "find": "'features' => [ から、対になる ], までのまとまり",
          "code": [
