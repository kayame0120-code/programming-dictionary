{
  "format": 2,
  "layer": "tech",
  "note": "app04×翻訳：app04（カテゴリ付きTODO・Laravel 8）の自作ファイル30本を読むのに要るファイルの種類。骨組みは Laravel 13 の形で出す",
  "files": [
    {
      "id": "file-controller",
      "name": "コントローラー",
      "lang": "php",
      "head": "controller",
      "marks": [
        "extends Controller"
      ],
      "path": "《ns|ns_path》《controller》.php",
      "cmd": [
        {
          "if": "ns=App\\Http\\Controllers",
          "t": "php artisan make:controller 《controller》"
        },
        {
          "if": "ns!=App\\Http\\Controllers",
          "t": "php artisan make:controller 《ns|ns_path》《controller》"
        }
      ],
      "summary": "画面やURLから呼ばれる係。メソッド1つが、1つの操作（一覧・保存・削除など）を受け持つ",
      "uses": [
        {
          "each": "models",
          "t": "use App\\Models\\《one》;"
        },
        {
          "each": "requests",
          "t": "use App\\Http\\Requests\\《one》;"
        },
        {
          "if": "ns!=App\\Http\\Controllers",
          "t": "use App\\Http\\Controllers\\Controller;"
        }
      ],
      "fields": [
        {
          "key": "controller",
          "label": "名前",
          "default": "TaskController",
          "reads": [
            "class\\s+(?<v>\\w+)\\s+extends\\s+Controller"
          ]
        },
        {
          "key": "ns",
          "label": "住所（namespace）",
          "default": "App\\Http\\Controllers",
          "reads": [
            "^namespace\\s+(?<v>[\\w\\\\]+);"
          ],
          "tr": "住所は 《ns》。ファイルの置き場所は 《ns|ns_path》 になる"
        },
        {
          "key": "models",
          "label": "使うモデル",
          "default": "",
          "reads_all": true,
          "reads": [
            "^use App\\\\Models\\\\(?<v>\\w+);"
          ]
        },
        {
          "key": "requests",
          "label": "使う決まり",
          "default": "",
          "reads_all": true,
          "reads": [
            "^use App\\\\Http\\\\Requests\\\\(?<v>\\w+);"
          ]
        }
      ],
      "sections": [
        {
          "key": "methods",
          "label": "メソッド"
        }
      ],
      "code": [
        "<?php",
        "",
        "namespace 《ns》;",
        "",
        "《@uses》",
        "",
        "class 《controller》 extends Controller",
        "{",
        "    《@methods》",
        "}"
      ],
      "o": 0
    },
