{
  "format": 2,
  "layer": "tech",
  "note": "土台：CSS の読み方の決まり。ファイルの種類と札は、アプリ×機能の束で足す",
  "tech": {
    "id": "css",
    "name": "CSS",
    "lang": "css"
  },
  "langs": {
    "css": "CSS"
  },
  "lang_rules": {
    "css": {
      "pair": {
        "head": "^[@<]?[\\w:-]+",
        "after": "[\\s>(]",
        "elif_after": "[\\s(]",
        "else_not": "[\\w(]"
      },
      "comments": [
        {
          "re": "\\{\\{--[\\s\\S]*?--\\}\\}"
        },
        {
          "re": "\\/\\*[\\s\\S]*?\\*\\/"
        },
        {
          "re": "(^|[^:'\"\\\\])\\/\\/[^\\n]*",
          "keep": 1
        }
      ]
    }
  }
}
